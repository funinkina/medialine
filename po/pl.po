#: prefs.js:34
msgid "About Medialine"
msgstr "O Medialine"

#: prefs.js:58 helpers/indicator.js:67
msgid "Medialine"
msgstr "Medialine"

#: prefs.js:62
msgid "Shows currently playing media in the top bar in a minimal elegant way."
msgstr "Wyświetla aktualnie odtwarzane multimedia w górnym pasku w minimalny i elegancki sposób."

#: prefs.js:73
msgid "Donate"
msgstr "Wesprzyj"

#: prefs.js:74
