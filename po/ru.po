msgid "Compact layout"
msgstr "Компактный режим"

#: prefs.js:317
msgid "Control how multi-source compact rows expand in the popup."
msgstr "Управляет раскрытием компактных строк с несколькими источниками во всплывающем окне."

#: prefs.js:322
msgid "Expand layout on"
msgstr "Раскрывать при"

#: prefs.js:322
